# Public origin must match the exact browser origin and HTTP Host.
FLOWW_PUBLIC_ORIGIN=http://127.0.0.1:4318
FLOWW_HOST=127.0.0.1
FLOWW_DEPLOYMENT_MODE=local
PORT=4318
FLOWW_DB_PATH=.runtime/floww.sqlite
# A separately configured managed Postgres database can replace local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Remote: set FLOWW_DEPLOYMENT_MODE=remote, FLOWW_HOST=0.0.0.0,
# PORT=10000, HTTPS FLOWW_PUBLIC_ORIGIN (or Render's RENDER_EXTERNAL_URL),
# and DATABASE_URL. Container-local SQLite is refused in remote mode.

SOLANA_RPC_URL=https://api.devnet.solana.com
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Set a test merchant's public Solana wallet address. Never use a private key here.
MERCHANT_PAY_TO=
PAYMENT_ASSET_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PAYMENT_AMOUNT_ATOMIC=1000
FLOWW_MAX_PAYMENT_ATOMIC=1000000
# Opt-in test payments only; the payer is a service wallet, not the login wallet.
FLOWW_ENABLE_DEVNET_PAYMENTS=false
# Owner-readable mode-0600 file containing the 64-byte test-only JSON keypair.
FLOWW_PAYER_KEY_FILE=

FLOWW_PYTHON=python3
# Optional language-model selection; explicit report requests work without it.
FLOWW_MODEL=
OPENAI_API_KEY=
